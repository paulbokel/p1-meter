# Copy to .env and adjust.
POSTGRES_PASSWORD=change-me
# POSTGRES_USER=p1
# POSTGRES_DB=p1

# HomeWizard P1 meter (enable "Local API" in the HomeWizard app first)
P1_HOST=192.168.178.187
P1_DRIVER=v1
P1_POLL_INTERVAL=1

# Web
BACKEND_PORT=8000
# P1_HOSTNAME=p1.home.lan   # used by the optional caddy service (profile "proxy")

# Day-ahead prices are fetched automatically for dynamic contracts
# FETCH_PRICES=true

# Backups (nightly pg_dump)
BACKUP_HOUR=3
BACKUP_KEEP=14
# BACKUP_DIR=/mnt/backup/p1
